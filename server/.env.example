# Server Port
PORT=5000

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://localhost:27017/servicedesk_pro
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/servicedesk_pro?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/servicedesk_pro

# Environment Mode
NODE_ENV=development

# Allowed CORS Origins (comma-separated list for production, e.g. https://servicedesk.example.com)
# In development, leave blank or omit to allow local development origins
CORS_ORIGIN=http://localhost:5173

# JWT Authentication
# Safe placeholder: replace with a secure, 32+ character random secret in local .env
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRES_IN=7d

# File Storage Provider (Default: local development storage)
# For production object storage (e.g. AWS S3, Cloudflare R2), configure:
STORAGE_PROVIDER=local
# AWS_S3_BUCKET=your_s3_bucket_name
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key


